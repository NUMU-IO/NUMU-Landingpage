# NUMU Landing Page — Environment Variables

# Backend API base URL (must include /api/v1 path)
VITE_API_URL=https://numueg.app/api/v1

# HeronSignal real-user monitoring — public key from Dashboard → Install.
# Safe to commit/expose: it only authorizes ingest for this workspace. Leave it
# unset to disable monitoring entirely (no telemetry, no console noise).
# The MCP/server token is a DIFFERENT, secret value — never put it here, since
# anything VITE_-prefixed is inlined into the browser bundle.
VITE_HERONSIGNAL_PUBLIC_KEY=

# PostHog — product analytics for the NUMU team (not merchant-facing).
# Project token from Settings → General. Write-only and safe to expose:
# it authorizes ingest only, and cannot read anything back. Leave unset to
# disable analytics entirely — no SDK is loaded, no network calls, no
# console noise. That is the intended state for local development.
VITE_POSTHOG_KEY=phc_wGRFSUmzbCoqaVnY3goMeRMxKiYp8Z7Y4pdkFDx6wBAx
# EU cloud, because we handle Egyptian customer data and it should not
# leave the region without a reason. Defaults to this when unset.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
