# NUMU Landing Page — Environment Variables

# Backend API base URL (must include /api/v1 path)
VITE_API_URL=https://numueg.app/api/v1

# HeronSignal real-user monitoring — public key from Dashboard → Install.
# Safe to commit/expose: it only authorizes ingest for this workspace. Leave it
# unset to disable monitoring entirely (no telemetry, no console noise).
# The MCP/server token is a DIFFERENT, secret value — never put it here, since
# anything VITE_-prefixed is inlined into the browser bundle.
VITE_HERONSIGNAL_PUBLIC_KEY=
